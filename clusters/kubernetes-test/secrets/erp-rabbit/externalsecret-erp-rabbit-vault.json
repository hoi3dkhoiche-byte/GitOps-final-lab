{
  "apiVersion": "external-secrets.io/v1",
  "kind": "ExternalSecret",
  "metadata": {
    "name": "erp-rabbit-vault",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    },
    "namespace": "erp"
  },
  "spec": {
    "data": [
      {
        "remoteRef": {
          "key": "erp/rabbitmq",
          "property": "username"
        },
        "secretKey": "username"
      },
      {
        "remoteRef": {
          "key": "erp/rabbitmq",
          "property": "password"
        },
        "secretKey": "password"
      }
    ],
    "refreshInterval": "1m",
    "secretStoreRef": {
      "kind": "SecretStore",
      "name": "vault-rabbit"
    },
    "target": {
      "creationPolicy": "Owner",
      "deletionPolicy": "Retain",
      "name": "erp-rabbit-vault",
      "template": {
        "engineVersion": "v2",
        "mergePolicy": "Replace",
        "type": "Opaque"
      }
    }
  }
}
