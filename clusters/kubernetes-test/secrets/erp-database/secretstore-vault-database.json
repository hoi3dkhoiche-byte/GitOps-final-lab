{
  "apiVersion": "external-secrets.io/v1",
  "kind": "SecretStore",
  "metadata": {
    "name": "vault-database",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    },
    "namespace": "erp"
  },
  "spec": {
    "provider": {
      "vault": {
        "auth": {
          "kubernetes": {
            "mountPath": "kubernetes-test",
            "role": "eso-erp-db",
            "serviceAccountRef": {
              "audiences": [
                "https://kubernetes.default.svc.cluster.local"
              ],
              "name": "eso-vault-db"
            }
          }
        },
        "caProvider": {
          "key": "ca.crt",
          "name": "vault-ca",
          "type": "ConfigMap"
        },
        "path": "kv",
        "server": "https://10.60.15.43:8200",
        "version": "v2"
      }
    }
  }
}
