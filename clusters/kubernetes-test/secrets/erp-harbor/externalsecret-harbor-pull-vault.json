{
  "apiVersion": "external-secrets.io/v1",
  "kind": "ExternalSecret",
  "metadata": {
    "name": "harbor-pull-vault",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    },
    "namespace": "erp"
  },
  "spec": {
    "dataFrom": [
      {
        "extract": {
          "key": "erp/harbor-pull"
        }
      }
    ],
    "refreshInterval": "1m",
    "secretStoreRef": {
      "kind": "SecretStore",
      "name": "vault-harbor"
    },
    "target": {
      "creationPolicy": "Owner",
      "deletionPolicy": "Retain",
      "name": "harbor-pull-vault",
      "template": {
        "engineVersion": "v2",
        "mergePolicy": "Replace",
        "type": "kubernetes.io/dockerconfigjson"
      }
    }
  }
}
